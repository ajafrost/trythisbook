# Anthropic API key — powers the /ask page (server-side only, never exposed to
# the client). Without it, /ask falls back to a random crowd-pleaser pick with a
# friendly note. Get one at platform.claude.com.
ANTHROPIC_API_KEY=sk-ant-...

# Aja's Goodreads "read" shelf RSS feed, merged in at build time. Copy the exact
# URL from the RSS icon at the bottom of your shelf page (it may include a
# personal ?key=... parameter). Optional — the site works from the CSV alone.
GOODREADS_RSS_URL=https://www.goodreads.com/review/list_rss/16162062?shelf=read

# Shared secret protecting /api/sync, sent by the Vercel cron job as a header.
CRON_SECRET=change-me

# ── /admin blurb editor ──────────────────────────────────────────────────────
# Password for the /admin login (pick anything). Required for the editor.
ADMIN_PASSWORD=change-me
# GitHub token so the editor's Save button can commit blurb edits back to the
# repo. Fine-grained PAT with "Contents: Read and write" on this repo only.
GITHUB_TOKEN=github_pat_...
# Optional overrides (default to this repo/branch):
# GITHUB_REPO=ajafrost/trythisbook
# GITHUB_BRANCH=main
